# Copy this file to `.env` and fill in real values.
# Backend: Django + DRF. See config/settings.py for how each var is consumed.

# ── Required — the app crashes at startup if this is missing ────────────────
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# ── Core ──────────────────────────────────────────────────────────────────
# Defaults to False (safe) if unset. Only set True for local development.
DEBUG=False
# Comma-separated. Defaults to localhost/127.0.0.1 only — add your real domain(s) in prod.
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────
# A single DATABASE_URL (Supabase pooler / any Postgres URL) wins over the
# discrete DB_* vars below. Leave both unset to fall back to local sqlite.
DATABASE_URL=
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# ── Cache (Redis) ─────────────────────────────────────────────────────────
# Required in any multi-process/production deployment — LocMemCache (the
# fallback when this is unset) is per-process and does not share state across
# workers. Upstash, Render Key Value, Railway Redis, or self-hosted all work.
#
# Render Key Value gives you two connection strings; use the INTERNAL one when
# the web service and the instance are in the same region — it stays on Render's
# private network, needs no TLS, and is not billed as egress:
#   REDIS_URL=redis://red-xxxxxxxxxxxxxxxxxxxx:6379
# Use the EXTERNAL one only from outside that network (local machine, CI, a
# service in another region). It is TLS-only, so the scheme must be rediss://
# and the password is part of the URL:
#   REDIS_URL=rediss://red-xxxxxxxxxxxxxxxxxxxx:PASSWORD@oregon-keyvalue.render.com:6379
# rediss:// needs no extra TLS options in settings.py — redis-py builds an SSL
# connection from the scheme, and Render serves a publicly-trusted certificate
# so the default verification succeeds.
#
# Verify after setting it:  python manage.py query_report --check
REDIS_URL=

# ── CORS / CSRF ───────────────────────────────────────────────────────────
# Comma-separated allowlist — never use a wildcard here.
CORS_ALLOWED_ORIGINS=http://localhost:5174
# Extra trusted origins beyond the built-in dev localhost list (which only
# applies when DEBUG=True) and the current production frontend default.
CSRF_TRUSTED_ORIGINS=https://specsit1.onrender.com

# ── Media storage (Supabase Storage, S3-compatible) ──────────────────────
# Required in production (Render's filesystem is ephemeral — without this,
# every uploaded product/brand/review image is lost on redeploy). These exact
# names are already provisioned in render.yaml / the Render dashboard.
# Leave SUPABASE_S3_BUCKET unset to keep using local disk (dev only).
SUPABASE_S3_BUCKET=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_PUBLIC_HOST=

# ── Admin panel ───────────────────────────────────────────────────────────
# Already namespaced off the Django default (served at /admin-django/, not /admin/).

# ── Email (optional — defaults to console backend, i.e. prints to stdout) ──
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# ── Google OAuth (optional) ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5174/auth/callback

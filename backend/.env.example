# Copy this file to `.env` and fill in real values.
# Backend: Django + DRF. See config/settings.py for how each var is consumed.

# ── Required — the app crashes at startup if this is missing ────────────────
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# ── Core ──────────────────────────────────────────────────────────────────
# Defaults to False (safe) if unset. Only set True for local development.
DEBUG=False
# Comma-separated. Defaults to localhost/127.0.0.1 only — add your real domain(s) in prod.
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────
# A single DATABASE_URL (Supabase pooler / any Postgres URL) wins over the
# discrete DB_* vars below. Leave both unset to fall back to local sqlite.
DATABASE_URL=
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# ── Cache (Redis) ─────────────────────────────────────────────────────────
# Required in any multi-process/production deployment — LocMemCache (the
# fallback when this is unset) is per-process and does not share state across
# workers. Upstash, Render Redis, Railway Redis, or self-hosted all work.
REDIS_URL=

# ── CORS / CSRF ───────────────────────────────────────────────────────────
# Comma-separated allowlist — never use a wildcard here.
CORS_ALLOWED_ORIGINS=http://localhost:5174
# Extra trusted origins beyond the built-in dev localhost list (which only
# applies when DEBUG=True) and the current production frontend default.
CSRF_TRUSTED_ORIGINS=https://specsit1.onrender.com

# ── Media storage (S3-compatible) ────────────────────────────────────────
# Required in production if your host has an ephemeral filesystem (e.g. Render) —
# without this, every uploaded product/brand/review image is lost on redeploy.
# Leave AWS_STORAGE_BUCKET_NAME unset to keep using local disk (fine for dev only).
# Works with real AWS S3 (leave AWS_S3_ENDPOINT_URL empty) or Supabase Storage
# (set AWS_S3_ENDPOINT_URL to https://<project-ref>.supabase.co/storage/v1/s3).
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=

# ── Admin panel ───────────────────────────────────────────────────────────
# Already namespaced off the Django default (served at /admin-django/, not /admin/).

# ── Email (optional — defaults to console backend, i.e. prints to stdout) ──
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# ── Google OAuth (optional) ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5174/auth/callback

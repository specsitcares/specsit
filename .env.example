# Environment Variables Example

# Copy this file to .env and fill in your actual values

## ========== DJANGO SETTINGS ==========
DEBUG=False
SECRET_KEY=your-super-secret-key-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

## ========== DATABASE CONFIGURATION ==========
# Single URL is preferred (overrides DB_* fallback). For docker-compose Postgres
# use the service host "db"; for Supabase use the pooler URL.
DATABASE_URL=postgresql://specsit:change_me@db:5432/specsit

## ========== DOCKER COMPOSE POSTGRES (compose interpolation only) ==========
POSTGRES_DB=specsit
POSTGRES_USER=specsit
POSTGRES_PASSWORD=change_me

## ========== REDIS CONFIGURATION (Upstash serverless) ==========
# TLS URL from the Upstash console; leave unset to fall back to local in-memory cache.
REDIS_URL=rediss://default:<token>@<region>.upstash.io:6379

## ========== EMAIL CONFIGURATION ==========
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True

## ========== AWS CONFIGURATION (Optional) ==========
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=us-east-1

## ========== SECURITY SETTINGS ==========
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

## ========== CORS SETTINGS ==========
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

## ========== FRONTEND CONFIGURATION ==========
VITE_API_URL=http://localhost:8000/api
VITE_APP_NAME=E-Commerce Platform

## ========== LOGGING ==========
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

## ========== PAYMENT GATEWAY (Razorpay) ==========
# Keys for live capture are managed in the admin Payment Settings; only the
# webhook secret lives in env (never the DB) for async event verification.
# REQUIRED: the webhook endpoint refuses every request while this is unset,
# rather than skipping signature verification as it used to. Must be set before
# RAZORPAY_LIVE_MODE is turned on.
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

## ========== SESSION / TOKEN LIFETIME ==========
# Auth tokens expire on both an idle timeout and an absolute cap; a token that
# breaches either is deleted server-side and the caller gets a 401.
TOKEN_IDLE_TIMEOUT_SECONDS=86400      # 24 hours without use
TOKEN_MAX_AGE_SECONDS=1209600         # 14 days from issue, however active

## ========== MEDIA STORAGE (Supabase Storage, S3-compatible) ==========
# Setting SUPABASE_S3_BUCKET switches media off local disk and onto the bucket.
SUPABASE_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-southeast-1
SUPABASE_S3_BUCKET=your-public-bucket
SUPABASE_S3_ACCESS_KEY_ID=your-s3-access-key
SUPABASE_S3_SECRET_ACCESS_KEY=your-s3-secret
# Host used to build stored file URLs. This is the PUBLIC object route, which
# Supabase serves only for buckets flagged public — point it at a private bucket
# and every image on the site answers `Bucket not found` while the files sit there
# untouched.
SUPABASE_S3_PUBLIC_HOST=<project-ref>.supabase.co/storage/v1/object/public/your-public-bucket

## ========== PRIVATE MEDIA ==========
# Prescriptions and face captures. They must NOT live in the bucket above: that one
# is public by necessity, so anything in it is readable by URL with no authorization
# in front of it. Give them their own private bucket — no public flag, no
# SUPABASE_S3_PUBLIC_HOST — and they are reached only by signed, expiring URLs.
# Leave this empty and they fall back to the public bucket, which is not safe for
# real customer uploads.
SUPABASE_S3_PRIVATE_BUCKET=your-private-bucket
# Signed-URL lifetime. Note these apply to the private bucket only: files addressed
# through SUPABASE_S3_PUBLIC_HOST are never signed, because django-storages drops
# signing entirely once a custom domain is set.
AWS_QUERYSTRING_AUTH=True
AWS_QUERYSTRING_EXPIRE=900            # signed-URL lifetime, seconds

# ========== THIRD-PARTY SERVICES ==========
SENTRY_DSN=https://your-sentry-dsn
VTRYON_API_KEY=your-client-vto-api-key-here

# KiksAR RTE / Virtual Try-On. Replace the `xxx` segment with your KiksAR
# client id (from the KiksAR integration doc). Exposed to the frontend via Vite.
VITE_KIKSAR_SCRIPT_URL=https://web-rte-static-files.s3.ap-south-1.amazonaws.com/xxx/kixr_integration.js

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback
